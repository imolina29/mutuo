# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mutuo?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Resend (email)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@mutuo.co"

# Encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY="generate-64-hex-chars-with-openssl-rand-hex-32"

# Supabase (Storage for encrypted identity docs)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin (comma-separated emails with access to /admin monitoring dashboard)
ADMIN_EMAILS="tu-email@ejemplo.com"
